<?xml version="1.0"?>
<!--
  Neon-Flight: the small turbojet of the Neon Wing (one per side). Dry thrust only, no afterburner.
  11 kN at sea level, static. The thrust tables are the normalized ones of JSBSim's stock J85 (a turbojet of the same class).
  Thrust follows N2 squared (FGTurbine), so it builds up as the engine spools: idle to full in about 2.5 s.
-->
<turbine_engine name="NeonJet">
  <milthrust unit="N"> 11000.0 </milthrust>
  <bypassratio>      0.0 </bypassratio>
  <tsfc>             0.85 </tsfc>
  <bleed>            0.0 </bleed>
  <idlen1>          30.0 </idlen1>
  <idlen2>          60.0 </idlen2>
  <maxn1>          100.0 </maxn1>
  <maxn2>          100.0 </maxn2>
  <augmented>          0 </augmented>
  <injected>           0 </injected>

  <!-- Spool rates (percent N per second): slower at the bottom of the range, like a real jet. -->
  <function name="N2SpoolUp">
    <table>
      <independentVar>propulsion/engine[#]/n2</independentVar>
      <tableData>
         60   10
         75   18
        100   22
      </tableData>
    </table>
  </function>
  <function name="N2SpoolDown">
    <value> 24 </value>
  </function>
  <function name="N1SpoolUp">
    <value> 30 </value>
  </function>
  <function name="N1SpoolDown">
    <value> 30 </value>
  </function>

  <function name="IdleThrust">
   <table>
    <independentVar lookup="row">velocities/mach</independentVar>
    <independentVar lookup="column">atmosphere/density-altitude</independentVar>
    <tableData>
         -10000     0     10000   20000   30000   40000   50000   60000
     0.0  0.0528  0.0488  0.0528  0.0694  0.0899  0.1183  0.1467  0.0
     0.2  0.0600  0.0501  0.0335  0.0544  0.0797  0.1049  0.1342  0.0
     0.4  0.0100  0.0047  0.0020  0.0272  0.0595  0.0891  0.1203  0.0
     0.6 -0.0600 -0.0804 -0.0560 -0.0237  0.0276  0.0718  0.1073  0.0
     0.8 -0.2000 -0.2129 -0.1498 -0.1025 -0.0195  0.0473  0.0868  0.0
     1.0 -0.2300 -0.2839 -0.1104 -0.0469 -0.0270 -0.0158  0.0552  0.0
    </tableData>
   </table>
  </function>

  <function name="MilThrust">
   <table>
    <independentVar lookup="row">velocities/mach</independentVar>
    <independentVar lookup="column">atmosphere/density-altitude</independentVar>
    <tableData>
          -10000       0   10000   20000   30000   40000   50000   60000
     0.0   1.2600  1.0000  0.7400  0.5340  0.3720  0.2410  0.1490  0.0
     0.2   1.1710  0.9340  0.6970  0.5060  0.3550  0.2310  0.1430  0.0
     0.4   1.1500  0.9210  0.6920  0.5060  0.3570  0.2330  0.1450  0.0
     0.6   1.1810  0.9510  0.7210  0.5320  0.3780  0.2480  0.1540  0.0
     0.8   1.2580  1.0200  0.7820  0.5820  0.4170  0.2750  0.1700  0.0
     1.0   1.3690  1.1200  0.8710  0.6510  0.4750  0.3150  0.1950  0.0
     1.2   1.4850  1.2300  0.9750  0.7440  0.5450  0.3640  0.2250  0.0
     1.4   1.5941  1.3400  1.0860  0.8450  0.6280  0.4240  0.2630  0.0
    </tableData>
